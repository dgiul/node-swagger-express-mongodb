# chatgpt-mcp configuration — copy this file to ".env" and fill in your key.
#   cp .env.example .env   then edit .env
#
# The ONLY required value is your OpenAI API key.

# Required: your OpenAI API key (starts with "sk-...").
OPENAI_API_KEY=

# Optional: which model ChatGPT should use. Default: gpt-4o
# Examples: gpt-4o, gpt-4o-mini, gpt-4.1, o3, gpt-5
OPENAI_MODEL=gpt-4o

# Optional: override the API base URL (any OpenAI-compatible endpoint).
# Default: https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
